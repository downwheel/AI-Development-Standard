                "name",
                "type",
                "secret",
                "required"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 64
          },
          "roles": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "inspect",
                    "application",
                    "migration",
                    "fixture",
                    "frontend"
