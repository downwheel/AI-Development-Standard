                "mappings": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string",
                    "pattern": "^[A-Z][A-Z0-9_]{0,95}$",
                    "maxLength": 96
                  }
                },
                "inherit_keys": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Z][A-Z0-9_]{0,95}$",
                    "maxLength": 96
                  },
                  "maxItems": 24
                }
              },
              "required": [
                "kind",
                "mappings"
              ],
              "additionalProperties": false
            }
          },
          "target_keys": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{0,95}$",
              "maxLength": 96
            },
            "minItems": 1,
            "maxItems": 16
          },
          "precedence": {
            "type": "string",
            "const": "profile-over-explicit-inheritance"
          }
        },
        "required": [
          "provider",
          "keys",
          "roles",
          "target_keys",
