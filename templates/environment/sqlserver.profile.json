{
  "provider": "sqlserver",
  "description": "Private development SQL Server profile. No target is selected until local values are entered and probed.",
  "keys": [
    {
      "name": "MSSQL_SERVER",
      "type": "string",
      "secret": false,
      "required": true,
      "description": "Server host and optional instance or port; enter locally."
    },
    {
      "name": "MSSQL_DATABASE",
      "type": "string",
      "secret": false,
      "required": true,
      "description": "Development database name; never assume an operational target."
    },
    {
      "name": "MSSQL_SCHEMA",
      "type": "string",
      "secret": false,
      "required": true,
      "description": "Explicit development schema."
    },
    {
      "name": "MSSQL_DRIVER",
      "type": "string",
      "secret": false,
      "required": true,
      "description": "Installed ODBC driver name, e.g. ODBC Driver 18 for SQL Server."
    },
    {
      "name": "MSSQL_AUTH",
      "type": "string",
      "secret": false,
      "required": true,
      "description": "sql or integrated; integrated authentication uses the current OS identity."
    },
    {
      "name": "MSSQL_ENCRYPT",
      "type": "boolean",
      "secret": false,
      "required": true,
      "description": "true is recommended."
    },
    {
      "name": "MSSQL_TRUST_SERVER_CERTIFICATE",
      "type": "boolean",
      "secret": false,
      "required": true,
      "description": "false verifies the server certificate."
    },
    {
      "name": "MSSQL_CONNECTION_TIMEOUT",
      "type": "integer",
      "secret": false,
      "required": true,
      "description": "Connection timeout in seconds.",
      "minimum": 1,
      "maximum": 30
    },
    {
      "name": "MSSQL_INSPECT_USER",
      "type": "string",
      "secret": true,
      "required": false,
      "description": "INSPECT role account, required only with SQL authentication."
    },
    {
      "name": "MSSQL_INSPECT_PASSWORD",
      "type": "string",
      "secret": true,
      "required": false,
      "description": "INSPECT role password, required only with SQL authentication."
    },
    {
      "name": "MSSQL_APPLICATION_USER",
      "type": "string",
      "secret": true,
      "required": false,
      "description": "APPLICATION role account, required only with SQL authentication."
    },
    {
      "name": "MSSQL_APPLICATION_PASSWORD",
      "type": "string",
      "secret": true,
      "required": false,
      "description": "APPLICATION role password, required only with SQL authentication."
    },
    {
      "name": "MSSQL_MIGRATION_USER",
      "type": "string",
      "secret": true,
      "required": false,
      "description": "MIGRATION role account, required only with SQL authentication."
    },
    {
      "name": "MSSQL_MIGRATION_PASSWORD",
      "type": "string",
      "secret": true,
      "required": false,
      "description": "MIGRATION role password, required only with SQL authentication."
    },
    {
      "name": "MSSQL_FIXTURE_USER",
      "type": "string",
      "secret": true,
      "required": false,
      "description": "FIXTURE role account, required only with SQL authentication."
    },
    {
      "name": "MSSQL_FIXTURE_PASSWORD",
      "type": "string",
      "secret": true,
      "required": false,
      "description": "FIXTURE role password, required only with SQL authentication."
    }
  ],
  "roles": {
    "inspect": {
      "kind": "inspect",
      "mappings": {
        "MSSQL_SERVER": "MSSQL_SERVER",
        "MSSQL_DATABASE": "MSSQL_DATABASE",
        "MSSQL_SCHEMA": "MSSQL_SCHEMA",
        "MSSQL_DRIVER": "MSSQL_DRIVER",
        "MSSQL_AUTH": "MSSQL_AUTH",
        "MSSQL_ENCRYPT": "MSSQL_ENCRYPT",
        "MSSQL_TRUST_SERVER_CERTIFICATE": "MSSQL_TRUST_SERVER_CERTIFICATE",
        "MSSQL_CONNECTION_TIMEOUT": "MSSQL_CONNECTION_TIMEOUT",
        "MSSQL_USER": "MSSQL_INSPECT_USER",
        "MSSQL_PASSWORD": "MSSQL_INSPECT_PASSWORD"
      },
      "inherit_keys": []
    },
    "application": {
      "kind": "application",
      "mappings": {
        "MSSQL_SERVER": "MSSQL_SERVER",
        "MSSQL_DATABASE": "MSSQL_DATABASE",
        "MSSQL_SCHEMA": "MSSQL_SCHEMA",
        "MSSQL_DRIVER": "MSSQL_DRIVER",
        "MSSQL_AUTH": "MSSQL_AUTH",
        "MSSQL_ENCRYPT": "MSSQL_ENCRYPT",
        "MSSQL_TRUST_SERVER_CERTIFICATE": "MSSQL_TRUST_SERVER_CERTIFICATE",
        "MSSQL_CONNECTION_TIMEOUT": "MSSQL_CONNECTION_TIMEOUT",
        "MSSQL_USER": "MSSQL_APPLICATION_USER",
        "MSSQL_PASSWORD": "MSSQL_APPLICATION_PASSWORD"
      },
      "inherit_keys": []
    },
    "migration": {
      "kind": "migration",
      "mappings": {
        "MSSQL_SERVER": "MSSQL_SERVER",
        "MSSQL_DATABASE": "MSSQL_DATABASE",
        "MSSQL_SCHEMA": "MSSQL_SCHEMA",
        "MSSQL_DRIVER": "MSSQL_DRIVER",
        "MSSQL_AUTH": "MSSQL_AUTH",
        "MSSQL_ENCRYPT": "MSSQL_ENCRYPT",
        "MSSQL_TRUST_SERVER_CERTIFICATE": "MSSQL_TRUST_SERVER_CERTIFICATE",
        "MSSQL_CONNECTION_TIMEOUT": "MSSQL_CONNECTION_TIMEOUT",
        "MSSQL_USER": "MSSQL_MIGRATION_USER",
        "MSSQL_PASSWORD": "MSSQL_MIGRATION_PASSWORD"
      },
      "inherit_keys": []
    },
    "fixture": {
      "kind": "fixture",
      "mappings": {
        "MSSQL_SERVER": "MSSQL_SERVER",
        "MSSQL_DATABASE": "MSSQL_DATABASE",
        "MSSQL_SCHEMA": "MSSQL_SCHEMA",
        "MSSQL_DRIVER": "MSSQL_DRIVER",
        "MSSQL_AUTH": "MSSQL_AUTH",
        "MSSQL_ENCRYPT": "MSSQL_ENCRYPT",
        "MSSQL_TRUST_SERVER_CERTIFICATE": "MSSQL_TRUST_SERVER_CERTIFICATE",
        "MSSQL_CONNECTION_TIMEOUT": "MSSQL_CONNECTION_TIMEOUT",
        "MSSQL_USER": "MSSQL_FIXTURE_USER",
        "MSSQL_PASSWORD": "MSSQL_FIXTURE_PASSWORD"
      },
      "inherit_keys": []
    }
  },
  "target_keys": [
    "MSSQL_SERVER",
    "MSSQL_DATABASE",
    "MSSQL_SCHEMA",
    "MSSQL_AUTH"
  ],
  "precedence": "profile-over-explicit-inheritance"
}
